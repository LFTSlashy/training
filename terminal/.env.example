# Server
PORT=8080
HOST=0.0.0.0
# Persisted users/accounts/watchlists (JSON) — defaults to server/data
DATA_DIR=
# Signing key for session tokens; auto-generated into DATA_DIR/.jwt-secret if empty
JWT_SECRET=
TOKEN_TTL_SEC=604800

# Demo account (created on first start)
DEMO_USER=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo1234

# Market simulation
MARKET_SEED=1234      # deterministic history
TICK_MS=500           # quote update interval
SIM_SPEED=3           # intraday volatility time multiplier (1 = real-time volatility)
HISTORY_DAYS=750      # days of daily history generated at boot

# Paper trading
STARTING_CASH=1000000
MAX_LEVERAGE=4
